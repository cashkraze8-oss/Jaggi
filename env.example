# --- required ---
API_ID=1234567
API_HASH=your_api_hash_from_my.telegram.org
BOT_TOKEN=new_token_from_BotFather
MONGO_URI=mongodb+srv://user:pass@cluster.mongodb.net/?retryWrites=true&w=majority
ADMIN_IDS=123456789

# --- optional ---
DB_NAME=media_bot
FORCE_SUB=DGDRIFT,driftarmyff     # public channel usernames, bot must be admin in each
UPLOAD_LIMIT_MB=1950              # Telegram max is ~2000
MAX_SOURCE_MB=4096                # refuse sources bigger than this (protects disk/time)
MAX_PARALLEL=2                    # simultaneous downloads
COOLDOWN_SECONDS=5
COMPRESS_CRF=20                   # 18-20 visually lossless; lower = bigger file
COOKIES_FILE=cookies.txt          # optional, helps with YouTube/Instagram login walls
IG_USERNAME=
IG_SESSION_FILE=
